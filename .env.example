# Use a random URL-safe secret, e.g. openssl rand -hex 32. Never commit .env.
POSTGRES_PASSWORD=replace_with_random_hex_password
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Production: APP_ORIGIN=https://your-domain.example and COOKIE_SECURE=true.
# Initial setup credentials are passed interactively; never place them in git.
